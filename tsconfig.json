{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react",
    "lib": ["ES2020", "DOM"],
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "types": ["chrome"]
  },
  "include": ["src", "utility.js", "main.tsx"],
  // Tests are typechecked separately (tsconfig.vitest.json) -- they use the
  // automatic JSX runtime and jest-dom matcher types, so keeping them out of the
  // app typecheck leaves `npm run typecheck` scoped to shipped code.
  "exclude": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"]
}
